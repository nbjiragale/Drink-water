<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- Live clock -->
        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="56sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_bg"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="4dp" />

        <!-- Date -->
        <TextView
            android:id="@+id/tvCurrentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saturday, May 17"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.06"
            android:layout_marginBottom="44dp" />

        <!-- Hero: glow + water drop -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_horizontal">

            <!-- Radial glow halo (single, smooth) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow_radial" />

            <!-- Water drop -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_water_glow"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/full_screen_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp" />

        <!-- Body -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/full_screen_body"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5" />

        <!-- Auto-dismiss countdown -->
        <TextView
            android:id="@+id/tvAutoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Closing in 30s"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.06"
            android:layout_marginBottom="20dp" />

        <!-- Dismiss pill button -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:text="@string/dismiss"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:background="@drawable/bg_btn_neon_dismiss"
            android:elevation="6dp" />

    </LinearLayout>
</FrameLayout>
