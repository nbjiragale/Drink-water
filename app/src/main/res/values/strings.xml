    <!-- Onboarding -->
    <string name="onboarding_notifications_title">Enable Notifications</string>
    <string name="onboarding_notifications_body">This app needs permission to show water reminders.\n\nPlease allow notifications so you never miss a hydration reminder.</string>

    <string name="onboarding_step_1_title">Enable Exact Alarms</string>
    <string name="onboarding_step_1_body">To receive reminders at the right time, this app needs permission to schedule exact alarms.\n\nThis ensures reminders fire precisely even when your phone is in deep sleep.</string>

    <string name="onboarding_step_2_title">Disable Battery Optimization</string>
    <string name="onboarding_step_2_body">Your device may aggressively stop background apps to save battery.\n\nTo ensure reminders are never missed, please exclude this app from battery optimization.</string>

    <string name="onboarding_step_3_title">Allow Background Auto-Start</string>
    <string name="onboarding_step_3_body">%1$s applies extra background restrictions that can silently block reminders.\n\nPlease add this app to the \'Auto-Start\' or \'Never Sleeping\' list in your system settings.</string>

